Material:
  # Standard PBR material — albedo texture, dielectric.
  Template: PBR.ehmaterialtype
  Params:
    BaseColor:
      Type: Float4
      Value: [1.0, 1.0, 1.0, 1.0]
    Metallic:
      Type: Float
      Value: [0.0]
    Roughness:
      Type: Float
      Value: [0.5]
    Occlusion:
      Type: Float
      Value: [1.0]
    UseAlbedoMap:
      Type: Float
      Value: [1.0]
  Textures:
    # Reflected sampler name (u_Albedo in PBR.slang) → texture asset path
    # (relative to the project's Assets directory).
    u_Albedo: Images/1.jpg
