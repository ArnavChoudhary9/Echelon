Material:
  # Standard PBR material — flat orange dielectric.
  Shader: shader:PBR.slang
  Params:
    BaseColor:
      Type: Float4
      Value: [1.0, 0.55, 0.2, 1.0]
    Metallic:
      Type: Float
      Value: [0.0]
    Roughness:
      Type: Float
      Value: [0.45]
    Occlusion:
      Type: Float
      Value: [1.0]
  # No Textures block: the surface shows the flat BaseColor.
