Material:
  # Matte solid dielectric — the rough end of the sphere metallic→rough row.
  Shader: shader:PBR.slang
  Params:
    BaseColor: { Type: Float4, Value: [0.72, 0.73, 0.75, 1.0] }
    Metallic:  { Type: Float,  Value: [0.0] }
    Roughness: { Type: Float,  Value: [0.95] }
    Occlusion: { Type: Float,  Value: [1.0] }
