RenderPipeline:
  resources:
    - { name: hdr,   format: RGBA16_FLOAT, size: swapchain }
    - { name: depth, format: D32_FLOAT,    size: swapchain }
    - { name: ldr,   format: RGBA8_UNORM,  size: swapchain }
  passes:
    # 1) Scene → offscreen HDR color (+ depth), rendered 4x MSAA and auto-resolved to `hdr`.
    - name: forward
      type: graphics
      samples: 4
      color:
        - { resource: hdr, load: clear, store: store, clear: [0.1, 0.1, 0.12, 1.0] }
      depth: { resource: depth, load: clear, store: dontcare }

    # 2) Color pass — a CUSTOM PROJECT shader (resolved from this project's Assets/,
    #    not the engine's built-in Shaders/). Swap to the built-in `Tonemap.slang` for
    #    the engine default.
    - name: tonemap
      type: fullscreen
      shader: Shaders/PostColor.slang
      inputs:
        - { resource: hdr, binding: 0 }
      color:
        - { resource: ldr, load: dontcare, store: store }

    # 3) FXAA anti-aliasing → backbuffer.
    - name: fxaa
      type: fullscreen
      shader: FXAA.slang
      inputs:
        - { resource: ldr, binding: 0 }
      color:
        - { resource: "$backbuffer", load: dontcare, store: store }
